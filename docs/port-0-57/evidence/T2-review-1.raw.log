   154	void CHyprBar::onMouseButton(Event::SCallbackInfo& info, IPointer::SButtonEvent e) {
   155	    // a menu Move/Resize is in progress or just ended with this click: the bars stay out of it
   156	    if (g_pGlobalState->grabActive || g_pGlobalState->grabSwallowPress)
   157	        return;
   158	
   159	    // middle, side and extra buttons are not ours (they used to count as a left click: middle-click on close closed the window)
   160	    if (e.button != BTN_LEFT && e.button != BTN_RIGHT)
   161	        return;
   162	
   163	    // overlapping bars all hear the same press: the first one that took it cancels it, the others must not act on it too
   164	    // (releases still go to every bar, so each can clear its own drag state)
   165	    if (e.state == WL_POINTER_BUTTON_STATE_PRESSED && info.cancelled)
   166	        return;
   167	
   168	    // a release must reach us wherever the pointer ended up (a drag can end over another layer, e.g. a panel at the
   169	    // screen edge, which input validation would reject)
   170	    if (e.state != WL_POINTER_BUTTON_STATE_PRESSED && e.button != BTN_RIGHT && (m_bDraggingThis || m_bCancelledDown || m_bDragPending)) {
   171	        handleUpEvent(info);
   172	        return;
   173	    }
   174	
   175	    if (!inputIsValid())
   176	        return;
   177	
   178	    if (e.state != WL_POINTER_BUTTON_STATE_PRESSED) {
   179	        if (e.button != BTN_RIGHT)
   180	            handleUpEvent(info);
   181	        return;
   182	    }
   183	
   184	    if (e.button == BTN_RIGHT) {
   185	        // right click on the bar: the window menu
   186	        const auto HEIGHT = g_pGlobalState->config.barHeight->value();
   187	        if (VECINRECT(cursorRelativeToBar(), 0, 0, assignedBoxGlobal().w, HEIGHT - 1)) {
   188	            if (Desktop::focusState()->window() != m_pWindow.lock())
   189	                Desktop::focusState()->fullWindowFocus(m_pWindow.lock(), Desktop::FOCUS_REASON_CLICK);
   190	            info.cancelled = true;
   191	            runAction("menu");
   192	        }
   193	        return;
   194	    }
   195	
   196	    handleDownEvent(info, std::nullopt);
   197	}
