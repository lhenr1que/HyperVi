    return {
        .overrideRedirect       = surface->m_overrideRedirect,
        .modal                  = surface->m_modal,
        .hasModalChild          = HAS_MODAL_CHILD,
        .transient              = surface->m_transient,
        .wantsFocus             = surface->wantsFocus(),
