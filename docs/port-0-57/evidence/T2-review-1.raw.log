        .suggestsNoInitialFocus = NO_INITIAL_FOCUS_ATOM,
        .preventsFocus          = PREVENTS_FOCUS_ATOM,
        .suggestsNoBorder       = NO_BORDER_ATOM || surface->m_overrideRedirect,
        .fullscreen             = surface->m_fullscreen,
    };
}

