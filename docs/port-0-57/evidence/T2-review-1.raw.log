        HYPRATOMS["_NET_WM_WINDOW_TYPE_DOCK"],         HYPRATOMS["_NET_WM_WINDOW_TYPE_DROPDOWN_MENU"], HYPRATOMS["_NET_WM_WINDOW_TYPE_MENU"],
        HYPRATOMS["_KDE_NET_WM_WINDOW_TYPE_OVERRIDE"],
