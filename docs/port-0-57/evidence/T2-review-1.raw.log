   105	// underPointer: this bar's window must be the one under the pointer (by default the focused window's bar also counts)
   106	bool CHyprBar::inputIsValid(bool underPointer) {
   107	    if (!barActive())
   108	        return false;
   109	
   110	    if (g_pSeatManager->m_seatGrab && !g_pSeatManager->m_seatGrab->accepts(m_pWindow->wlSurface()->resource()))
   111	        return false;
   112	
   113	    const auto MOUSE    = g_pInputManager->getMouseCoordsInternal();
   114	    auto       PMONITOR = Desktop::focusState()->monitor();
   115	
   116	    if (!PMONITOR)
   117	        return false;
   118	
   119	    Desktop::CViewHitTester hitTester{*Desktop::viewState()};
   120	
   121	    const auto              WINDOWATCURSOR = hitTester.windowAt(MOUSE, Desktop::View::RESERVED_EXTENTS | Desktop::View::INPUT_EXTENTS | Desktop::View::ALLOW_FLOATING);
   122	
   123	    auto                    focusState = Desktop::focusState();
   124	    auto                    window     = focusState->window();
   125	
   126	    if (WINDOWATCURSOR != m_pWindow && (underPointer || m_pWindow != window))
   127	        return false;
   128	
   129	    PHLLS    foundSurface = nullptr;
   130	    Vector2D surfaceCoords;
   131	
   132	    // Check Top Layer
   133	    hitTester.layerSurfaceAt(MOUSE, &PMONITOR->m_layerSurfaceLayers[ZWLR_LAYER_SHELL_V1_LAYER_TOP], &surfaceCoords, &foundSurface);
   134	    if (foundSurface)
   135	        return false;
   136	
   137	    // Check Overlay Layer
   138	    hitTester.layerSurfaceAt(MOUSE, &PMONITOR->m_layerSurfaceLayers[ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY], &surfaceCoords, &foundSurface);
   139	    if (foundSurface)
   140	        return false;
   141	
   142	    return true;
   143	}
