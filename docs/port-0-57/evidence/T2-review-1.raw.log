    out=$(for V in "" -DT2_DTOR_NO_ERASE; do echo "variant ${V:-real-dtor}"; $ENV $1 $V -std=c++2b -Wall -Werror -fsanitize=address,undefined -fno-sanitize-recover=all -I$d $(pkg-config --cflags hyprutils) "$E/T2-hostfree.cpp" -o $d/t 2>&1 && ASAN_OPTIONS=detect_leaks=1 $d/t 2>&1 || exit 1; done); rc=$?
    if [ "$4" = ok ] && [ $rc -eq 0 ]; then ok "host-free $3 [$1]: $(grep -c "^ALL OK" <<<"$out")/2 variants ALL OK"
    elif [ "$4" = fail ] && [ $rc -ne 0 ]; then ok "host-free $3 [$1] killed: $(grep -E 'variant|FAIL|error' <<<"$out" | grep -m1 -B1 -E 'FAIL|error' | tr '\n' ' ')"
    else bad "host-free $3 [$1] rc=$rc"; echo "$out" | head -8; fi
