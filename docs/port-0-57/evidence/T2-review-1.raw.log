        HYPRATOMS["_NET_WM_WINDOW_TYPE_COMBO"],      HYPRATOMS["_NET_WM_WINDOW_TYPE_MENU"],         HYPRATOMS["_NET_WM_WINDOW_TYPE_SPLASH"],
