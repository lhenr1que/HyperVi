// SPDX-License-Identifier: MIT
// Part of kwinish (Copyright (c) 2026 lhen).
// Tests for barInput.hpp (no Hyprland): bash tools/test-plugin-input.sh
// Built with -DKW_BASELINE against docs/port-0-57/evidence/T4-tests/baseline-barInput.hpp it must fail (T4 red).
#include <barInput.hpp> // angle brackets: only the -I directory, so the baseline copy can stand in for it

#include <chrono>
#include <cstdio>
#include <string>

using namespace KwIn;
using clk = std::chrono::steady_clock;

static int fails = 0;

static void check(bool okay, const std::string& what) {
    std::printf("%s - %s\n", okay ? "ok" : "FALHOU", what.c_str());
    fails += okay ? 0 : 1;
}

// The drag the baseline started or ended; the alpha-0 header has no drag state at all (plugin sources are checked for
// begin/end calls by tools/test-plugin-input.sh).
static int drags(const SClicks& c) {
#ifdef KW_BASELINE
    return c.dragStarts + c.dragEnds + c.snaps + c.dragging + c.pending;
#else
    (void)c;
    return 0;
#endif
}
static void motion(SClicks& c) {
#ifdef KW_BASELINE
    c.motion();
#else
    (void)c;
#endif
}
static void facts(bool focused, bool floating, bool maximized) {
#ifdef KW_BASELINE
    g_focused = focused, g_floating = floating, g_maximized = maximized;
#else
    (void)focused, (void)floating, (void)maximized;
#endif
}

static const clk::time_point T0{};
static SPress down(eHit hit, uint32_t button = BTN_LEFT, bool valid = true, bool taken = false) {
    return {button, true, taken, valid, hit};
}
static SPress up(uint32_t button = BTN_LEFT, bool valid = true) {
    return {button, false, false, valid, eHit::OUTSIDE};
}
static bool same(SResult r, eAction a, bool cancel) {
    return r.action == a && r.cancel == cancel;
}

int main() {
    using namespace std::chrono_literals;

    // D1: a press on the title never starts a drag: floating, tiled, maximized, with or without motion
    for (const auto& [floating, maximized, name] : {std::tuple{true, false, "floating"}, {false, false, "tiled"}, {true, true, "maximized"}}) {
        facts(true, floating, maximized);
        SClicks c;
        const auto P = c.onButton(down(eHit::TITLE), true, T0);
        motion(c);
        const auto R = c.onButton(up(), true, T0 + 1s);
        check(same(P, eAction::FOCUS, true), std::string(name) + ": title press focuses and is taken");
        check(same(R, eAction::NONE, true), std::string(name) + ": its release is taken too");
        check(drags(c) == 0, std::string(name) + ": no drag started, ended or snapped");
    }
    facts(true, true, false);

    // pairs: every press a bar takes has its release taken, wherever focus or the pointer went
    {
        SClicks c;
        check(same(c.onButton(down(eHit::BUTTON), true, T0), eAction::BUTTON, true), "button press runs the button once");
        facts(false, true, false); // minimize moved focus away
        check(same(c.onButton(up(BTN_LEFT, false), true, T0), eAction::NONE, true), "release after minimize (focus gone, pointer off) is taken");
        facts(true, true, false);
        check(same(c.onButton(up(), true, T0), eAction::NONE, false), "a second release is not ours");
    }
    {
        SClicks c;
        check(same(c.onButton(down(eHit::TITLE, BTN_RIGHT), true, T0), eAction::BAR_MENU, true), "right press on the bar opens the menu");
        check(same(c.onButton(up(BTN_RIGHT), true, T0), eAction::NONE, true), "right release goes with it");
        check(same(c.onButton(down(eHit::BUTTON, BTN_RIGHT), true, T0), eAction::BAR_MENU, true), "right press on a button opens the menu too");
        check(same(c.onButton(up(BTN_RIGHT, false), true, T0), eAction::NONE, true), "right release off the bar still goes with it");
    }
    {
        SClicks c;
        check(same(c.onButton(down(eHit::ICON), true, T0), eAction::ICON_MENU, true), "icon press opens the menu under the icon");
        check(same(c.onButton(up(BTN_LEFT, false), true, T0), eAction::NONE, true), "icon release (pointer now on the menu) is taken");
        check(drags(c) == 0, "icon: no drag");
    }

    // presses the bar does not take pass in pairs
    {
        SClicks c;
        check(same(c.onButton(down(eHit::OUTSIDE), true, T0), eAction::NONE, false), "press off the bar passes");
        check(same(c.onButton(up(), true, T0), eAction::NONE, false), "and its release passes");
        check(same(c.onButton(down(eHit::TITLE, BTN_LEFT, false), true, T0), eAction::NONE, false), "press where the bar takes no input passes");
        check(same(c.onButton(up(), true, T0), eAction::NONE, false), "and its release passes");
        check(same(c.onButton(down(eHit::TITLE, BTN_MIDDLE), true, T0), eAction::NONE, false), "middle press passes");
        check(same(c.onButton(up(BTN_MIDDLE), true, T0), eAction::NONE, false), "middle release passes");
        check(same(c.onButton(down(eHit::BUTTON, BTN_SIDE), true, T0), eAction::NONE, false), "side button passes, even on a button");
        check(same(c.onButton(up(BTN_SIDE), true, T0), eAction::NONE, false), "side release passes");
        check(same(c.onButton(up(), true, T0), eAction::NONE, false), "a release with no press passes");
        check(same(c.onButton(up(BTN_RIGHT), true, T0), eAction::NONE, false), "a right release with no press passes");
    }

    // two buttons at once: each pair is its own
    {
        SClicks c;
        c.onButton(down(eHit::TITLE), true, T0);
        check(same(c.onButton(down(eHit::OUTSIDE, BTN_RIGHT), true, T0), eAction::NONE, false), "right press off the bar while left is held passes");
        check(same(c.onButton(up(BTN_RIGHT), true, T0), eAction::NONE, false), "its release passes");
        check(same(c.onButton(up(), true, T0), eAction::NONE, true), "the left release is still taken");
    }

    // overlapping bars: the first takes the press, the other leaves it and its release alone
    {
        SClicks a, b;
        const auto PA = a.onButton(down(eHit::BUTTON), true, T0);
        const auto PB = b.onButton(down(eHit::BUTTON, BTN_LEFT, true, PA.cancel), true, T0);
        check(same(PA, eAction::BUTTON, true) && same(PB, eAction::NONE, false), "overlapping bars: one action");
        const auto RA = a.onButton(up(), true, T0), RB = b.onButton(up(), true, T0);
        check(RA.cancel && !RB.cancel, "overlapping bars: the release is taken once, by the bar that took the press");
    }

    // double click on the title (on_double_click), unchanged
    {
        SClicks c;
        c.onButton(down(eHit::TITLE), true, T0);
        c.onButton(up(), true, T0);
        check(same(c.onButton(down(eHit::TITLE), true, T0 + 300ms), eAction::DOUBLE_CLICK, true), "second press within 400 ms is a double click");
        c.onButton(up(), true, T0);
        check(same(c.onButton(down(eHit::TITLE), true, T0 + 399ms), eAction::DOUBLE_CLICK, true), "a third quick press is another double (as before)");
        c.onButton(up(), true, T0);
        check(same(c.onButton(down(eHit::TITLE), true, T0 + 1s), eAction::FOCUS, true), "after 400 ms it is a plain press again");
        c.onButton(up(), true, T0);
        check(same(c.onButton(down(eHit::TITLE), false, T0 + 1100ms), eAction::FOCUS, true), "on_double_click empty: never a double click");
        c.onButton(up(), true, T0);
        check(drags(c) == 0, "double click: no drag");
    }
    {
        SClicks c;
        c.onButton(down(eHit::BUTTON), true, T0);
        c.onButton(up(), true, T0);
        check(same(c.onButton(down(eHit::TITLE), true, T0 + 100ms), eAction::FOCUS, true), "a button press does not count toward a double click");
    }

    // Lua grab(mode, address): bad arguments keep their messages, a valid request is refused (no silent return)
    check(grabError(false, true, "") == "grab: expected (\"move\"|\"resize\", address)", "grab without a mode");
    check(grabError(true, false, "move") == "grab: expected (\"move\"|\"resize\", address)", "grab without an address");
    check(grabError(true, true, "spin") == "grab: mode must be move or resize", "grab with an unknown mode");
    check(grabError(true, true, "move").find("unavailable") != std::string::npos, "grab move is refused as unavailable");
    check(grabError(true, true, "resize").find("unavailable") != std::string::npos, "grab resize is refused as unavailable");

    if (fails)
        std::printf("%d falha(s)\n", fails);
    return fails ? 1 : 0;
}
// T4 red baseline: the click decisions of plugin/barDeco.cpp and luaGrab in plugin/main.cpp at bf2049a, extracted by hand
// with the same interface as plugin/barInput.hpp (mouse path only; touch is covered by the structural check). Model of the
// baseline, not the compiled plugin: onMouseButton :154-194, handleDownEvent :348-428, handleUpEvent :612-659,
// onMouseMove :282-325 (pending drag), luaGrab main.cpp :304-322.
#pragma once

#include <chrono>
#include <cstdint>
#include <optional>
#include <string>
#include <string_view>

#include <linux/input-event-codes.h>

namespace KwIn {
    enum class eHit : uint8_t { OUTSIDE, BUTTON, ICON, TITLE };
    enum class eAction : uint8_t { NONE, BUTTON, ICON_MENU, BAR_MENU, DOUBLE_CLICK, FOCUS };

    struct SPress {
        uint32_t button  = BTN_LEFT;
        bool     pressed = true;
        bool     taken   = false;
        bool     valid   = false;
        eHit     hit     = eHit::OUTSIDE;
    };

    struct SResult {
        eAction action = eAction::NONE;
        bool    cancel = false;
    };

    // host facts the baseline read that the alpha-0 decision no longer needs
    inline bool g_focused  = true; // the bar's window has focus (at release)
    inline bool g_floating = true;
    inline bool g_maximized = false;

    struct SClicks {
        bool dragging = false, pending = false, cancelledDown = false;
        int  dragStarts = 0, dragEnds = 0, snaps = 0; // KwDrag::begin, changeMouseBindMode/mouse 0movewindow, snapOnRelease
        std::optional<std::chrono::steady_clock::time_point> lastTitle;

        SResult up() {
            SResult r;
            if (!g_focused) {
                if (dragging)
                    ++dragEnds;
                dragging = cancelledDown = pending = false;
                return r; // release not cancelled
            }
            if (cancelledDown)
                r.cancel = true;
            cancelledDown = false;
            if (dragging) {
                ++dragEnds;
                dragging = false;
                ++snaps;
            }
            pending = false;
            return r;
        }

        void motion() {
            if (!pending)
                return;
            pending = false;
            ++dragStarts;
            dragging = true;
        }

        SResult onButton(const SPress& e, bool doubleClickOn, std::chrono::steady_clock::time_point now) {
            if (e.button != BTN_LEFT && e.button != BTN_RIGHT)
                return {};
            if (e.pressed && e.taken)
                return {};
            if (!e.pressed && e.button != BTN_RIGHT && (dragging || cancelledDown || pending))
                return up();
            if (!e.valid)
                return {};
            if (!e.pressed) {
                if (e.button != BTN_RIGHT)
                    return up();
                return {}; // right release ignored
            }
            if (e.button == BTN_RIGHT) {
                if (e.hit != eHit::OUTSIDE)
                    return {eAction::BAR_MENU, true};
                return {};
            }
            if (e.hit == eHit::OUTSIDE) {
                if (dragging)
                    ++dragEnds;
                dragging = pending = false;
                return {};
            }
            cancelledDown = true;
            if (e.hit == eHit::BUTTON)
                return {eAction::BUTTON, true};
            if (e.hit == eHit::ICON) {
                pending = false;
                return {eAction::ICON_MENU, true};
            }
            if (doubleClickOn && lastTitle && now - *lastTitle < std::chrono::milliseconds(400)) {
                pending = false;
                return {eAction::DOUBLE_CLICK, true};
            }
            lastTitle = now;
            if (g_floating && !g_maximized) {
                ++dragStarts;
                dragging = true;
            } else
                pending = true;
            return {eAction::FOCUS, true};
        }
    };

    // baseline: a valid request starts the grab (no error)
    inline std::string grabError(bool modeIsString, bool addressIsString, std::string_view mode) {
        if (!modeIsString || !addressIsString)
            return "grab: expected (\"move\"|\"resize\", address)";
        if (mode != "move" && mode != "resize")
            return "grab: mode must be move or resize";
        return "";
    }
}
#!/usr/bin/env bash
# T4 red: tools/test-plugin-input.sh against the plugin sources of a commit (default bf2049a, the T4 base), with the
# click decisions of that commit (baseline-barInput.hpp, a hand extraction). Must exit 1 by assertion, never by a
# compile error. Usage: run-red.sh [commit]   (log: stdout)
set -u
here=$(cd "$(dirname "$0")" && pwd -P); root=$(cd "$here/../../../.." && pwd -P); rev=${1:-bf2049a}
b=$(mktemp -d); trap 'rm -rf -- "$b"' EXIT
for f in barDeco.cpp barDeco.hpp main.cpp globals.hpp; do git -C "$root" show "$rev:plugin/$f" > "$b/$f" || exit 2; done
cp "$here/baseline-barInput.hpp" "$b/barInput.hpp"
rc=0
for c in g++ clang++; do
  echo "== $rev $c"
  out=$(CXX=$c KWINISH_SRC=$b KWINISH_CXXFLAGS=-DKW_BASELINE bash "$root/tools/test-plugin-input.sh" 2>&1); r=$?
  printf '%s\nexit=%s\n' "$out" "$r"
  # red means: exit 1, the test built and ran, and at least one behavioural assertion failed
  if [ "$r" != 1 ] || grep -q "FALHOU - compilar" <<<"$out" || ! grep -qE "^FALHOU - [a-z]+.*(press|release|drag|grab)" <<<"$out"; then rc=1; echo "NOT RED as required ($c)"; fi
done
exit $rc
#!/usr/bin/env bash
# T4 mutations: each mutant must build and then die by assertion (a build error does not count as killed).
# H*: plugin/barInput.hpp under tools/test-plugin-input.sh; S*: plugin sources under its structural check;
# R*: ui/src/menu.rs under cargo test no_move_or_resize_in_alpha0. Usage: run-mutations.sh   (log: stdout)
set -u
here=$(cd "$(dirname "$0")" && pwd -P); root=$(cd "$here/../../../.." && pwd -P)
w=$(mktemp -d); trap 'rm -rf -- "$w"' EXIT
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
killed=0 total=0 bad=0

# mutate <file> <python-literal old> <python-literal new>: exactly one occurrence must change
mutate() {
  python3 - "$1" "$2" "$3" <<'EOF' || exit 3
import sys, ast
p, old, new = sys.argv[1], ast.literal_eval(sys.argv[2]), ast.literal_eval(sys.argv[3])
s = open(p).read()
if s.count(old) != 1: sys.exit(f"mutation anchor not unique ({s.count(old)}): {old!r}")
open(p, 'w').write(s.replace(old, new))
EOF
}

plug() { # id, file, old, new
  local id=$1; total=$((total + 1))
  rm -rf "$w/p"; cp -r "$root/plugin" "$w/p"; mutate "$w/p/$2" "$3" "$4"
  out=$(KWINISH_SRC="$w/p" bash "$root/tools/test-plugin-input.sh" 2>&1); r=$?
  if grep -q "FALHOU - compilar" <<<"$out"; then echo "BUILD $id (not counted as killed)"; bad=$((bad + 1))
  elif [ "$r" != 0 ] && grep -q "^FALHOU" <<<"$out"; then echo "killed $id: $(grep -m1 '^FALHOU' <<<"$out")"; killed=$((killed + 1))
  else echo "SURVIVED $id"; bad=$((bad + 1)); fi
}

menu() { # id, old, new
  local id=$1; total=$((total + 1))
  rm -rf "$w/ui" "$w/core"; mkdir -p "$w/ui" "$w/core"; cp -r "$root/ui/Cargo.toml" "$root/ui/Cargo.lock" "$root/ui/src" "$w/ui/"; cp -r "$root/core/testdata" "$w/core/"; mutate "$w/ui/src/menu.rs" "$2" "$3"
  out=$(HOME="$w/h" XDG_CONFIG_HOME="$w/h/c" CARGO_TARGET_DIR="$root/ui/target" cargo test --locked --manifest-path "$w/ui/Cargo.toml" no_move_or_resize 2>&1); r=$?
  if grep -q "^error\[" <<<"$out" || grep -q "could not compile" <<<"$out"; then echo "BUILD $id (not counted as killed)"; bad=$((bad + 1))
  elif [ "$r" != 0 ] && grep -q "panicked" <<<"$out"; then echo "killed $id: $(grep -m1 -A1 'panicked' <<<"$out" | tail -1)"; killed=$((killed + 1))
  else echo "SURVIVED $id"; bad=$((bad + 1)); fi
}

