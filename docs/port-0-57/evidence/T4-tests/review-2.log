// Presses on the bar: barInput.hpp decides and records the pair (main.cpp takes the release); this feeds it the pointer
// test and runs the result. Alpha-0 (openspec disable-titlebar-drag-alpha0): a press on the title never moves the window.
void CHyprBar::onMouseButton(Event::SCallbackInfo& info, IPointer::SButtonEvent e) {
    KwIn::SPress p{.button = e.button, .pressed = e.state == WL_POINTER_BUTTON_STATE_PRESSED, .taken = info.cancelled};
    if (!p.pressed || p.taken || (e.button != BTN_LEFT && e.button != BTN_RIGHT))
        return;
    std::optional<size_t> button;
    if (inputIsValid()) {
        p.valid           = true;
        const auto COORDS = cursorRelativeToBar();
        const auto IB     = iconBox();
        if (!VECINRECT(COORDS, 0, 0, assignedBoxGlobal().w, g_pGlobalState->config.barHeight->value() - 1))
            p.hit = KwIn::eHit::OUTSIDE;
        else if ((button = buttonAt(COORDS)))
            p.hit = KwIn::eHit::BUTTON;
        else if (!IB.empty() && VECINRECT(COORDS, IB.x, IB.y, IB.x + IB.w, IB.y + IB.h))
            p.hit = KwIn::eHit::ICON;
        else
            p.hit = KwIn::eHit::TITLE;
    }

    const auto ON_DOUBLE_CLICK = g_pGlobalState->config.onDoubleClick->value();
    struct SHost {
        CHyprBar&             bar;
        Event::SCallbackInfo& info;
        PHLWINDOW             w;
        std::optional<size_t> button;
        std::string           doubleClick;
        void                  cancel() {
            info.cancelled = true;
        }
        void focus() {
            if (w && Desktop::focusState()->window() != w)
                Desktop::focusState()->fullWindowFocus(w, Desktop::FOCUS_REASON_CLICK);
        }
        void raiseIfFloating() {
            if (w && w->isFloating())
                Desktop::windowState()->raise(w);
        }
        void run(KwIn::eAction a) {
            switch (a) {
                case KwIn::eAction::BUTTON: bar.runAction(g_pGlobalState->buttons[*button].cmd); break;
                case KwIn::eAction::ICON_MENU: {
                    // the window menu, under the icon
                    const auto BOX = bar.assignedBoxGlobal();
                    bar.openMenu(BOX.x + g_pGlobalState->config.barPadding->value(), BOX.y + BOX.h);
                    break;
                }
                case KwIn::eAction::BAR_MENU: bar.runAction("menu"); break; // right click on the bar
                case KwIn::eAction::DOUBLE_CLICK: bar.runAction(doubleClick); break;
                default: break;
            }
        }
    } host{*this, info, m_pWindow.lock(), button, ON_DOUBLE_CLICK};
    KwIn::apply(m_clicks.onPress(p, g_pGlobalState->pairs, !ON_DOUBLE_CLICK.empty(), Time::steadyNow()), host);
}

// Wheel over the bar: up raises the window, down lowers it (KWin's titlebar wheel action).
void CHyprBar::onMouseAxis(Event::SCallbackInfo& info, const IPointer::SAxisEvent& e) {
    if (e.axis != WL_POINTER_AXIS_VERTICAL_SCROLL || e.delta == 0.0 || !validMapped(m_pWindow) || !inputIsValid())
        return;

    const auto HEIGHT = g_pGlobalState->config.barHeight->value();
    return 0;
}

// hl.plugin.kwinish.grab(mode, address): Move/Resize from the window menu. Off in alpha-0 (openspec
// disable-titlebar-drag-alpha0): the call stays registered and always answers with a Lua error (barInput.hpp).
int luaGrab(lua_State* L) {
    return Config::Lua::Bindings::Internal::configError(L, KwIn::grabError(lua_isstring(L, 1), lua_isstring(L, 2), lua_isstring(L, 1) ? lua_tostring(L, 1) : ""));
}

// hl.plugin.kwinish.set_bar_hidden(address, hidden): the window menu's "no title bar and frame".
int luaSetBarHidden(lua_State* L) {
    if (!lua_isstring(L, 1) || !lua_isboolean(L, 2))
        return Config::Lua::Bindings::Internal::configError(L, "set_bar_hidden: expected (address, boolean)");
    const auto key = (uintptr_t)std::strtoull(lua_tostring(L, 1), nullptr, 0);
    if (lua_toboolean(L, 2))
        g_pGlobalState->hiddenBars.insert(key);
    else
        g_pGlobalState->hiddenBars.erase(key);
    for (auto& b : g_pGlobalState->bars)
        if (b && (uintptr_t)b->getOwner().get() == key)
            b->onFloatingChanged(); // re-places the bar, which now reserves (or frees) its height
    return 0;
}

int luaClearZones(lua_State*) {
    g_pGlobalState->zones.clear();
    return 0;
}


APICALL EXPORT PLUGIN_DESCRIPTION_INFO PLUGIN_INIT(HANDLE handle) {
    PHANDLE = handle;

    const std::string HASH        = __hyprland_api_get_hash();
    const std::string CLIENT_HASH = __hyprland_api_get_client_hash();

    if (HASH != CLIENT_HASH) {
        HyprlandAPI::addNotification(PHANDLE, "[kwinish-bars] Failure in initialization: Version mismatch (headers ver is not equal to running hyprland ver)",
                                     CHyprColor{1.0, 0.2, 0.2, 1.0}, 5000);
        throw std::runtime_error("[kwinish-bars] Version mismatch");
    }

    g_pGlobalState                    = makeUnique<SGlobalState>();
    g_pGlobalState->nobarRuleIdx      = Desktop::Rule::windowEffects()->registerEffect("kwinish:no_bar");
    g_pGlobalState->barColorRuleIdx   = Desktop::Rule::windowEffects()->registerEffect("kwinish:bar_color");
    g_pGlobalState->titleColorRuleIdx = Desktop::Rule::windowEffects()->registerEffect("kwinish:title_color");
    // window keys are pointers and get reused: forget what was kept for a window when it closes
    static auto PC = Event::bus()->m_events.window.close.listen([&](PHLWINDOW w) {
        const auto key = (uintptr_t)w.get();
        g_pGlobalState->hiddenBars.erase(key);
        g_pGlobalState->restores.erase(key);
    });
    // any click puts the button tooltip away until the pointer leaves the button (KDE); the release of a press a bar took
    // is the bar's too, wherever the pointer went and even if the bar is gone (barInput.hpp)
    static auto PG = Event::bus()->m_events.input.mouse.button.listen([&](IPointer::SButtonEvent e, Event::SCallbackInfo& info) {
        if (e.state == WL_POINTER_BUTTON_STATE_PRESSED) {
            tipHide(false);
            g_pGlobalState->tip.pressed = true;
        } else if (g_pGlobalState->pairs.onRelease(e.button).cancel)
            info.cancelled = true;
    });
    static auto P7 = Event::bus()->m_events.window.active.listen([&](PHLWINDOW, Desktop::eFocusReason) {
        // active/inactive colours: every bar repaints and re-renders its title when focus moves
        for (auto& b : g_pGlobalState->bars)
            if (b)
                b->onFocusChanged();
    });
    static auto P6 = Event::bus()->m_events.window.floating.listen([&](PHLWINDOW w) {
        // floating_only: a bar appears or disappears when the window changes mode
        for (auto& b : g_pGlobalState->bars)
            if (b && b->getOwner() == w)
                b->onFloatingChanged();
    });
    // the button tooltip goes after every window: drawn with its bar it would sit under the bar's own window
    static auto PR = Event::bus()->m_events.render.stage.listen([&](eRenderStage stage) {
        if (stage != RENDER_POST_WINDOWS)
            return;
        const auto M = g_pHyprRenderer->m_renderData.pMonitor.lock();
        if (const auto& tip = g_pGlobalState->tip; M && !tip.bar.expired())
            tip.bar->drawTip(M);
    });
    static auto P4 = Event::bus()->m_events.config.preReload.listen([&] { onPreConfigReload(); });
    static auto P5 = Event::bus()->m_events.config.reloaded.listen([&] { onConfigReloaded(); });

    // add deco to existing windows
    for (auto& w : Desktop::windowState()->windows()) {
        if (w->isHidden() || !w->mapped())
            continue;

        onNewWindow(w);
    }

    HyprlandAPI::reloadConfig();

    return {"kwinish-bars", "Title bars for Kwinish (fork of hyprbars).", "lhen, Vaxry (hyprbars)", "0.1"};
}

APICALL EXPORT void PLUGIN_EXIT() {
    for (auto& m : State::monitorState()->monitors())
        m->m_scheduledRecalc = true;

    g_pHyprRenderer->m_renderPass.removeAllOfType("CBarPassElement");
    g_pHyprRenderer->m_renderPass.removeAllOfType("CPreviewPassElement"); // queued by the drag preview: it would outlive the library

    // the event loop keeps its own reference to the tooltip timer, and its callback is code of this library
    tipHide(true);
    if (g_pGlobalState->tip.timer)
        g_pEventLoopManager->removeTimer(g_pGlobalState->tip.timer);
    g_pGlobalState->tip.timer.reset();

    Desktop::Rule::windowEffects()->unregisterEffect(g_pGlobalState->barColorRuleIdx);
    Desktop::Rule::windowEffects()->unregisterEffect(g_pGlobalState->titleColorRuleIdx);
    Desktop::Rule::windowEffects()->unregisterEffect(g_pGlobalState->nobarRuleIdx);
}
#!/usr/bin/env bash
# Alpha-0 title-bar input (openspec disable-titlebar-drag-alpha0), no Hyprland needed:
#  1. builds and runs plugin/test_input.cpp against plugin/barInput.hpp (click decisions and pairs, grab refusal);
#  2. checks the plugin sources for any route left that starts, ends or arms a window drag, touch on the bar, or the
#     menu grab (the code that cannot be run without the compositor).
# KWINISH_SRC=<dir> checks another copy of plugin/, KWINISH_CXXFLAGS adds compiler flags (both used to show the checks
# fail on the baseline: docs/port-0-57/evidence/T4-tests/run-red.sh).
set -u
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P) || exit 1
src=${KWINISH_SRC:-$root/plugin}
t=$(mktemp -d "${TMPDIR:-/tmp}/kwinish-test-input.XXXXXXXX") || exit 1
trap 'rm -rf -- "$t"' EXIT
cxx=${CXX:-g++}
command -v "$cxx" >/dev/null || { echo "FALHOU - falta o compilador $cxx"; exit 1; }
fails=0

if "$cxx" -std=c++2b -Wall -Wextra -Werror ${KWINISH_CXXFLAGS:-} -I "$src" "$root/plugin/test_input.cpp" -o "$t/test_input"; then
  "$t/test_input" || fails=$((fails + 1))
else
  echo "FALHOU - compilar plugin/test_input.cpp"; fails=$((fails + 1))
fi

# absent: pattern must not appear in the file
absent() {
  local file=$1 pat=$2 what=$3
  [ -f "$src/$file" ] || { echo "FALHOU - $what: $file missing"; fails=$((fails + 1)); return; }
  if grep -nE -- "$pat" "$src/$file" >"$t/hits"; then
    echo "FALHOU - $what ($file):"; sed 's/^/    /' "$t/hits"; fails=$((fails + 1))
  else
    echo "ok - $what"
  fi
}
present() {
  local file=$1 pat=$2 what=$3
  if grep -qE -- "$pat" "$src/$file"; then echo "ok - $what"; else echo "FALHOU - $what ($file)"; fails=$((fails + 1)); fi
}

for f in barDeco.cpp main.cpp; do
  absent "$f" 'KwDrag::|hostDrag\.hpp' "no drag begin/end helper"
  absent "$f" 'changeMouseBindMode|g_pKeybindManager|movewindow|MBIND_' "no mouse-bind start/end/rearm"
  absent "$f" 'grabActive|grabSwallowPress' "no menu grab state"
  absent "$f" 'holdAtSeam|createFunctionHook|onMouseMoved|m_rearmPending|KEY_LEFTSHIFT' "no seam-resistance hook or Shift rearm"
done
absent barDeco.cpp 'm_bDraggingThis|m_bDragPending|m_bCancelledDown|m_bTouchEv|m_touchId|m_dragStart|m_pressCursor|m_unsnap|m_resist' "no drag/touch/unsnap state"
absent barDeco.cpp 'snapOnRelease|maybeUnsnap|stepUnsnap|handleMovement|handleDownEvent|handleUpEvent' "no drag, unsnap or snap-on-release routes"
absent barDeco.cpp 'ITouch|input\.touch|onTouch' "no touch on the bar"
absent barDeco.cpp 'hyprctl eval' "the bar sends no snap to the core"
absent barDeco.hpp 'ITouch|onTouch|m_bDraggingThis|m_bDragPending|m_bCancelledDown|m_rearmPending|holdAtSeam|rearmDrag|snapOnRelease|maybeUnsnap|stepUnsnap' "header: no drag/touch members"
absent globals.hpp 'grabActive|grabSwallowPress' "globals: no grab flags"
present barDeco.cpp 'KwIn::apply\(m_clicks\.onPress\(p, g_pGlobalState->pairs' "onMouseButton decides and acts through barInput.hpp"
present main.cpp 'g_pGlobalState->pairs\.onRelease\(e\.button\)\.cancel' "releases are taken by the listener that outlives the bars"
present main.cpp 'KwIn::grabError\(' "luaGrab answers through barInput.hpp"
# the preview stays compiled (its render port is group R), but nothing draws it in alpha-0
n=$(grep -c 'drawSnapPreview(' "$src/barDeco.cpp")
if [ "$n" = 1 ]; then echo "ok - drawSnapPreview defined, never called"; else echo "FALHOU - drawSnapPreview( appears $n times in barDeco.cpp (want 1: the definition)"; fails=$((fails + 1)); fi

[ "$fails" = 0 ] && echo "input: tudo passou" || { echo "input: $fails grupo(s) falharam"; exit 1; }

exec
/usr/bin/bash -lc "rg -n 'Para a próxima sessão' docs/STATUS.md; head -85 docs/DEVELOPMENT_STATE.md; cat openspec/changes/disable-titlebar-drag-alpha0/tasks.md; cat docs/port-0-57/evidence/T4-tests/mutations.log; cat docs/port-0-57/evidence/T4-tests/build-compare-{gcc,clang}.txt; rg -n 'cancelled|emit' /usr/include/hyprland/src/helpers/signal/* /usr/include/hyprland/src/event/* /usr/include/hyprutils/signal/*; git rev-parse --short HEAD; ls docs/port-0-57/evidence/T4-tests" in /home/lhen/Projects/ryoku-work/kwinish-port-0-57
 succeeded in 0ms:
