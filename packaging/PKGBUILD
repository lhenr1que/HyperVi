# Maintainer: lhenr1que <lhenriqueds99@gmail.com>
# Local build recipe from a clone (source is the clone itself); before an AUR submission, point source at the GitHub repository.
pkgname=hypervi-git
pkgver=0.0.0.r125.60e8e18
pkgrel=1
pkgdesc='HyperVi: KWin-style window management for Hyprland 0.57 (Lua core, GTK4 layer-shell UI)'
arch=('x86_64')
url='https://github.com/lhenr1que/HyperVi'
license=('MIT')
depends=('hyprland' 'gtk4' 'gtk4-layer-shell')
makedepends=('git' 'cargo')
checkdepends=('lua')
provides=('hypervi')
conflicts=('hypervi')
source=("kwinish::git+file://${KWINISH_SRC:-$PWD/..}")
sha256sums=('SKIP')

pkgver() {
  cd kwinish
  printf '0.0.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd kwinish/ui
  cargo build --release --locked
}

check() {
  cd kwinish
  bash tools/check.sh --lua-only
}

package() {
  cd kwinish
  install -Dm755 ui/target/release/kwinish-ui "$pkgdir/usr/bin/kwinish-ui"
  install -d "$pkgdir/usr/share/kwinish/core" "$pkgdir/usr/share/kwinish/recipes"
  install -m644 core/{kwinish,geometry,binds,switcher,layouts,rules,modes,assist,settings,kwjson}.lua "$pkgdir/usr/share/kwinish/core/"
  install -m644 recipes/*.lua "$pkgdir/usr/share/kwinish/recipes/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/kwinish/README.md"
}
