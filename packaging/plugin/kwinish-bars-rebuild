#!/bin/sh
# Rebuilds the kwinish-bars plugin for the installed Hyprland (a plugin is locked to one Hyprland build).
# Run by the pacman hook after hyprland changes, or by hand: sudo kwinish-bars-rebuild
# Never fails the pacman transaction: if the build fails the old plugin stays and Kwinish runs in emergency mode.
src=${KWINISH_PLUGIN_SRC:-/usr/share/kwinish/plugin-src}
dest=${KWINISH_PLUGIN_DEST:-/usr/lib/hyprland/plugins}

if ! command -v g++ >/dev/null 2>&1 || ! command -v make >/dev/null 2>&1 || ! pkg-config --exists hyprland; then
    echo "kwinish-bars: g++, make and the hyprland headers are needed to rebuild the plugin (pacman -S gcc make hyprland)."
    echo "kwinish-bars: until then Kwinish runs in emergency mode with its fallback title bars."
    exit 0
fi

tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
cp -r "$src"/. "$tmp"/

if ! make -C "$tmp" abi >"$tmp/build.log" 2>&1; then
    echo "kwinish-bars: rebuild failed; last lines of the build log:"
    tail -n 15 "$tmp/build.log"
    echo "kwinish-bars: the old plugin was kept; Kwinish runs in emergency mode until a rebuild works."
elif install -Dm755 "$tmp/kwinish-bars.so" "$dest/kwinish-bars.so" && install -Dm644 "$tmp/kwinish-bars.abi" "$dest/kwinish-bars.abi"; then
    echo "kwinish-bars: rebuilt for Hyprland $(pkg-config --modversion hyprland). Restart Hyprland or run: hyprctl plugin load $dest/kwinish-bars.so"
else
    echo "kwinish-bars: rebuilt, but installing it into $dest failed (see above); run: sudo kwinish-bars-rebuild"
fi
exit 0
